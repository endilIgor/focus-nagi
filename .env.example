# Copy to .env and fill in real values. Never commit .env.
# Owner login (seeded on first start)
APP_OWNER_USERNAME=owner
APP_OWNER_PASSWORD=change-me-to-a-long-random-secret

# Docker Compose PostgreSQL credentials. Replace the password before internet deployment.
POSTGRES_DB=focusnagi
POSTGRES_USER=focusnagi
POSTGRES_PASSWORD=change-me-to-a-long-random-database-secret
POSTGRES_PORT=5432

# App timezone for analytics boundaries (e.g. America/Sao_Paulo)
APP_TIME_ZONE=UTC

# Allowed browser origins (comma separated). Empty = same-origin only, no CORS headers.
APP_CORS_ALLOWED_ORIGINS=

# Set true when serving over HTTPS. Keep false only for local HTTP development.
APP_COOKIE_SECURE=false

# Expose Swagger UI / OpenAPI without authentication (default false)
APP_SWAGGER_ENABLED=false
