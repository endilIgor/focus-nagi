# Frontend build-time configuration. Copy to .env.local for `npm run dev`; on Vercel set these in
# Project Settings -> Environment Variables. Never put the service_role / sb_secret_ key here.

# Supabase project URL and anon (publishable) key. Both are public by design; RLS protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Leave empty to call same-origin /api (Vercel rewrite / Vite dev proxy). Only set it when the
# browser must call the Worker cross-origin (then also set CORS_ALLOWED_ORIGINS on the Worker).
VITE_API_BASE_URL=

# Vercel build only: Cloudflare Worker origin that /api/* is proxied to (no path, no trailing slash).
API_ORIGIN=https://focus-nagi-api.your-account.workers.dev
