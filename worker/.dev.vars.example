# Copy to .dev.vars for `npm run dev` (wrangler dev). Never commit .dev.vars.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Comma-separated Supabase auth user ids allowed to use the API (the single owner).
ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000
# Only needed for projects still using the legacy HS256 JWT secret.
# SUPABASE_JWT_SECRET=
APP_TIME_ZONE=UTC
CORS_ALLOWED_ORIGINS=http://localhost:5173
